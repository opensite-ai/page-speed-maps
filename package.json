{
  "name": "@page-speed/maps",
  "version": "0.1.4",
  "description": "Performance-optimized MapLibre React components and style utilities for DashTrack.",
  "keywords": [
    "react",
    "maplibre",
    "maps",
    "stadia",
    "page-speed",
    "tree-shakable",
    "dashtrack"
  ],
  "homepage": "https://github.com/opensite-ai/page-speed-maps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensite-ai/page-speed-maps.git"
  },
  "bugs": {
    "url": "https://github.com/opensite-ai/page-speed-maps/issues"
  },
  "author": "OpenSite AI (https://opensite.ai)",
  "license": "BSD-3-Clause",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./core/map-libre": {
      "types": "./dist/core/MapLibre.d.ts",
      "import": "./dist/core/MapLibre.js",
      "require": "./dist/core/MapLibre.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./utils/style-url": {
      "types": "./dist/utils/getMapLibreStyleUrl.d.ts",
      "import": "./dist/utils/getMapLibreStyleUrl.js",
      "require": "./dist/utils/getMapLibreStyleUrl.cjs"
    },
    "./utils/google-links": {
      "types": "./dist/utils/googleMapLinks.d.ts",
      "import": "./dist/utils/googleMapLinks.js",
      "require": "./dist/utils/googleMapLinks.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./hooks/useGeoCenter": {
      "types": "./dist/hooks/useGeoCenter.d.ts",
      "import": "./dist/hooks/useGeoCenter.js",
      "require": "./dist/hooks/useGeoCenter.cjs"
    },
    "./hooks/useDefaultZoom": {
      "types": "./dist/hooks/useDefaultZoom.d.ts",
      "import": "./dist/hooks/useDefaultZoom.js",
      "require": "./dist/hooks/useDefaultZoom.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "bundle-analysis": "node scripts/analyze-bundle.mjs",
    "prepublish": "pnpm run build && pnpm run type-check && pnpm run test:ci",
    "prepublishOnly": "pnpm run prepublish"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "maplibre-gl": "^5.18.0",
    "react-map-gl": "^8.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.0.10",
    "jsdom": "^27.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.0.10"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
